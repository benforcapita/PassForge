{
  "manifest_version": 3,
  "name": "PassForge",
  "version": "0.1.0",
  "description": "Stateless password manager — deterministic generation, nothing stored.",
  "action": {
    "default_title": "PassForge (Ctrl+Shift+L)",
    "default_popup": "index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      }
    }
  },
  "permissions": ["activeTab", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
